# Optional: copy to .env. Real environment variables win over this file.
# Every value may be left empty; the defaults below are what an empty value means.

# Off by default. run.bat / run.sh turn it on for local work.
DJANGO_DEBUG=0

# Empty -> a random key is generated once and stored in .secret_key (gitignored).
DJANGO_SECRET_KEY=

# Comma separated. Default: localhost,127.0.0.1,[::1]. Use * only on a trusted LAN.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed behind HTTPS on a real domain, e.g. https://sklad.example.uz
DJANGO_CSRF_TRUSTED_ORIGINS=

# Turn these on only when the site is served over HTTPS.
DJANGO_SECURE_COOKIES=0
DJANGO_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0
DJANGO_BEHIND_HTTPS_PROXY=0

# Where db.sqlite3 and .secret_key live (default: project folder; Docker: /data).
DJANGO_DATA_DIR=
DJANGO_DB_PATH=
